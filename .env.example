# Copy this file to .env and fill in your desired values.
# The .env file is ignored by git to keep your secrets safe.

# --- Cluster Configuration ---
# Number of worker nodes per cluster (blue/green)
NUM_WORKER_NODES=1
# Memory per VM in MB
VM_MEMORY=2048
# Number of CPUs per VM
VM_CPUS=2

# --- Network Configuration ---
BLUE_IP_PREFIX="192.168.90."
GREEN_IP_PREFIX="192.168.91."
HOST_PORT_PREFIX_BLUE="101"
HOST_PORT_PREFIX_GREEN="102"

# --- Security ---
# A shared secret for K3s cluster membership.
# For production, generate a long, random string.
K3S_TOKEN="my-super-secret-k3s-token"