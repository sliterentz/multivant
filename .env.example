# Multivant Configuration File
# Copy this file to .env and adjust values as needed

# ============================================================================
# CLUSTER CONFIGURATION
# ============================================================================

# Number of worker nodes per cluster (blue and green)
NUM_WORKER_NODES=2

# ============================================================================
# RESOURCE ALLOCATION
# ============================================================================

# Control Plane (Master Nodes)
CONTROL_PLANE_MEMORY=4096
CONTROL_PLANE_CPUS=2

# Data Plane (Worker Nodes)
DATA_PLANE_MEMORY=2048
DATA_PLANE_CPUS=2

# Build Plane
BUILD_PLANE_MEMORY=4096
BUILD_PLANE_CPUS=2

# Observability Plane
OBSERVABILITY_MEMORY=4096
OBSERVABILITY_CPUS=2

# Identity Plane
IDENTITY_PLANE_MEMORY=2048
IDENTITY_PLANE_CPUS=2

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# IP Prefixes (VirtualBox allowed range: 192.168.56.0/21)
BLUE_IP_PREFIX=192.168.56.
GREEN_IP_PREFIX=192.168.57.
SHARED_SERVICES_IP_PREFIX=192.168.58.

# Port Prefixes for Host Port Forwarding
HOST_PORT_PREFIX_BLUE=81
HOST_PORT_PREFIX_GREEN=82

# ============================================================================
# SECURITY
# ============================================================================

# K3s Token (REQUIRED - Generate with: openssl rand -hex 32)
K3S_TOKEN="my-super-secret-k3s-token"

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/Disable Platform Planes
ENABLE_OBSERVABILITY=true
ENABLE_IDENTITY_PLANE=false
ENABLE_BUILD_PLANE=true

# ============================================================================
# ANSIBLE CONFIGURATION
# ============================================================================

# Enable verbose Ansible output
ANSIBLE_VERBOSE=false

# Timezone configuration (default: UTC)
# Examples: America/New_York, Europe/London
TIMEZONE=America/New_York